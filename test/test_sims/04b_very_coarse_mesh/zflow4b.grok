!--------------------------  Problem description
Very coarse discrete fractures and porous matrix mesh.
Flow only, driven vertically: head 50 at z=0 and 40 at z=25.
Based on Module04b by S.Berg, July 21, 2014.
end title
!--------------------------  Grid generation
generate variable blocks
! x,y,z- count of grid lines and grid line locations
6
   0.    10.   20.   25.   30.   50.
2
   0.    1.
5
   0.    6.    12.   20.   25.
end grid generation

!--------------------------  General simulation parameters
units: kilogram-metre-second
finite difference mode
control volume
!-------------------------- Porous Media Properties
use domain type
porous media

properties file
module4b.mprops

clear chosen elements
choose elements block
   0.0   50.0
   0.0    1.0
   12.0  25.0
new zone
   1

clear chosen zones
choose zone number
1
read properties
porous medium

clear chosen elements
choose elements block
   0.0   50.0
   0.0    1.0
   0.0   12.0
new zone
   2

clear chosen zones
choose zone number
2
read properties
porous medium 2

!--------------------------  Fracture media properties
use domain type
fracture

properties file
f_cd.fprops

!--------------------------  fracture 1
clear chosen faces
choose faces block
-0.01, 30.1
-0.01, 1.01
19.9, 20.1

new zone
1

clear chosen zones
choose zone number
1

read properties
fracture1

!--------------------------  fracture 2
choose faces x plane
25
1.e-5

new zone
2

clear chosen zones
choose zone number
2

read properties
fracture2


!--------------------------  fracture 3
clear chosen faces
choose faces block
19.9, 50.1
-0.01, 1.01
5.9, 6.1
new zone
3

clear chosen zones
choose zone number
3

read properties
fracture3



!--------------------------  Porous media flow
use domain type
porous media

choose nodes all
initial head
45

!--------------------------  h1 boundary condition assignment
clear chosen nodes

choose nodes z plane
0.0
1.e-5

create node set
h1

boundary condition
    type
    head

    node set
    h1

    time value table
       0 50
    end


end ! new specified head


!--------------------------  h2 boundary condition assignment
clear chosen nodes

choose nodes z plane
25
1.e-5

create node set
h2

boundary condition
    type
    head

    node set
    h2

    time value table
       0 40
    end

end ! new specified head


!-------------------------- Output
output times
86400
end
